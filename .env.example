# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database. Leave empty for local dev (embedded PGlite in ./.data).
# REQUIRED on Vercel: add Neon from the Vercel Marketplace, it sets DATABASE_URL for you.
DATABASE_URL=

# AI provider: claude | openai | grok | gemini. Can be overridden in /admin.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
XAI_API_KEY=
XAI_MODEL=grok-4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Midtrans (Snap). Without these keys, checkout runs in demo mode in development only.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
UNLOCK_PRICE_IDR=29000

# Admin panel at /admin
ADMIN_PASSWORD=
ADMIN_SECRET=

# Contact shown in footer and legal pages (required by Midtrans merchant review)
NEXT_PUBLIC_CONTACT_EMAIL=
# Meta Pixel ID for ads measurement (optional)
NEXT_PUBLIC_META_PIXEL_ID=
